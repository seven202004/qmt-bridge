# QMT Bridge 配置
# 复制此文件为 .env 并按需修改:  cp .env.example .env

# 监听地址 (0.0.0.0 表示允许局域网访问)
QMT_BRIDGE_HOST=0.0.0.0

# 监听端口
QMT_BRIDGE_PORT=18888

# 日志级别: critical/error/warning/info/debug（同时作用于 uvicorn 与本项目 logger）
QMT_BRIDGE_LOG_LEVEL=info

# 日志文件路径（留空只输出到控制台）。目录不存在会自动创建
# QMT_BRIDGE_LOG_FILE=logs/qmt-bridge.log

# 单个日志文件大小上限（字节，默认 10MB），超过后轮转
# QMT_BRIDGE_LOG_MAX_BYTES=10485760

# 保留的历史日志文件数量（默认 5）
# QMT_BRIDGE_LOG_BACKUP_COUNT=5

# 是否输出每个 HTTP 请求的访问日志（带 request_id 与耗时，默认开启）
# QMT_BRIDGE_LOG_ACCESS=true

# uvicorn worker 数量 (Windows 下建议保持 1)
QMT_BRIDGE_WORKERS=1

# API Key（用于保护交易端点，留空则交易端点不可用）
# QMT_BRIDGE_API_KEY=your-secret-api-key

# 是否要求数据端点也进行认证（默认否，仅交易端点需要认证）
# QMT_BRIDGE_REQUIRE_AUTH_FOR_DATA=false

# 是否启用交易模块（默认否）
# QMT_BRIDGE_TRADING_ENABLED=false

# miniQMT 安装路径（交易模块需要）
# QMT_BRIDGE_MINI_QMT_PATH=C:\国金QMT交易端\userdata_mini

# 交易账户 ID
# QMT_BRIDGE_TRADING_ACCOUNT_ID=12345678

# ============================================================
# 定时下载调度器配置（qmt-scheduler 独立进程读取）
# ============================================================

# 是否执行 K 线增量下载（默认 true）
# QMT_BRIDGE_SCHEDULER_KLINE_ENABLED=true

# K 线周期，逗号分隔（默认 1d,5m,1m）
# QMT_BRIDGE_SCHEDULER_KLINE_PERIODS=1d,5m,1m

# K 线下载板块，逗号分隔（默认 沪深A股,沪深ETF,沪深指数）
# QMT_BRIDGE_SCHEDULER_KLINE_SECTORS=沪深A股,沪深ETF,沪深指数

# 是否执行财务数据增量下载（默认 true）
# QMT_BRIDGE_SCHEDULER_FINANCIAL_ENABLED=true

# 财务数据板块，逗号分隔（默认 沪深A股；财务数据只对 A 股有意义）
# QMT_BRIDGE_SCHEDULER_FINANCIAL_SECTORS=沪深A股

# ============================================================
# 通知推送配置
# ============================================================

# 是否启用通知推送（默认否）
# QMT_BRIDGE_NOTIFY_ENABLED=false

# 通知后端，多个用逗号分隔: feishu, webhook
# QMT_BRIDGE_NOTIFY_BACKENDS=feishu

# 允许推送的事件类型（逗号分隔，留空=全部）
# 可选值: trade, order, order_error, cancel_error, connected, disconnected,
#         asset, position, account_status, async_response, async_cancel_response
# QMT_BRIDGE_NOTIFY_EVENT_TYPES=trade,order_error,cancel_error,connected,disconnected

# 排除的事件类型（逗号分隔）
# QMT_BRIDGE_NOTIFY_IGNORE_EVENT_TYPES=asset,position

# --- 飞书群机器人 Webhook ---
# QMT_BRIDGE_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# QMT_BRIDGE_FEISHU_WEBHOOK_SECRET=your-feishu-signing-secret

# --- 通用 HTTP Webhook ---
# QMT_BRIDGE_WEBHOOK_URL=https://your-server.com/webhook
# QMT_BRIDGE_WEBHOOK_SECRET=your-webhook-secret
